# Any OpenAI-compatible provider: just paste its base URL (the part before /chat/completions).
# Note: the triage stage uses tool calling, so the provider must support it.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Knowledge base file (plain text, sections separated by "---" lines),
# relative to the backend working directory.
KNOWLEDGE_BASE_PATH=knowledge_base.md
